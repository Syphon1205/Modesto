{
  "name": "@modesto/monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-beta.103",
      "@effect/platform-node": "4.0.0-beta.103",
      "@effect/platform-node-shared": "4.0.0-beta.103",
      "@effect/platform-bun": "4.0.0-beta.103",
      "@effect/atom-react": "4.0.0-beta.103",
      "@effect/sql-pg": "4.0.0-beta.103",
      "@effect/tsgo": "0.13.2",
      "@effect/openapi-generator": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/openapi-generator@8881a9b",
      "@effect/sql-sqlite-bun": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/sql-sqlite-bun@8881a9b",
      "@effect/vitest": "4.0.0-beta.103",
      "@effect/language-service": "0.75.1",
      "@types/bun": "^1.3.9",
      "@types/node": "24.12.4",
      "@typescript/native-preview": "7.0.0-dev.20260604.1",
      "tsdown": "^0.20.3",
      "typescript": "~6.0.3",
      "vitest": "^4.0.0",
      "vite-plus": "0.2.2",
      "@clerk/backend": "3.14.0",
      "@clerk/clerk-js": "6.29.2",
      "@clerk/electron": "0.0.34",
      "@clerk/electron-passkeys": "0.0.3",
      "@clerk/react": "6.14.4",
      "@clerk/shared": "4.29.2",
      "@noble/curves": "1.9.1",
      "@noble/hashes": "1.8.0",
      "@pierre/diffs": "1.3.0-beta.10",
      "@legendapp/list": "3.3.5",
      "jose": "6.2.2",
      "yaml": "^2.9.0"
    }
  },
  "type": "module",
  "scripts": {
    "modesto": "bun run start:desktop",
    "modesto:dev": "node scripts/dev-runner.ts dev:desktop --home-dir ./.modesto/electron-dev",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:marketing": "turbo run dev --filter=@modesto/marketing",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "electron": "bun run start:desktop",
    "electron:dev": "node scripts/dev-runner.ts dev:desktop --home-dir ./.modesto/electron-dev",
    "start": "turbo run start --filter=@modesto/cli",
    "start:desktop": "turbo run start --filter=@modesto/desktop",
    "start:marketing": "turbo run preview --filter=@modesto/marketing",
    "build": "turbo run build",
    "build:marketing": "turbo run build --filter=@modesto/marketing",
    "build:desktop": "turbo run build --filter=@modesto/desktop --filter=@modesto/cli",
    "devices:inspect": "bun run scripts/inspect-device-model.ts",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "turbo run test",
    "brand:check": "node scripts/check-brand-identity.ts",
    "test:desktop-smoke": "turbo run smoke-test --filter=@modesto/desktop",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:contracts": "turbo run build --filter=@modesto/contracts",
    "dist:desktop:artifact": "node scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "node scripts/build-desktop-artifact.ts --platform mac --target dmg",
    "dist:desktop:dmg:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:x64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "dist:desktop:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:desktop:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "release:smoke": "node scripts/release-smoke.ts",
    "release:smoke:mac-update": "node scripts/smoke-mac-update-artifact.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules scripts/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .turbo apps/*/.turbo packages/*/.turbo"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "turbo": "^2.3.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.103",
    "effect": "4.0.0-beta.103",
    "vite": "^8.0.0"
  },
  "engines": {
    "bun": "^1.3.9",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.3.12",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  },
  "patchedDependencies": {
    "effect@4.0.0-beta.103": "patches/effect@4.0.0-beta.103.patch",
    "@effect/vitest@4.0.0-beta.103": "patches/@effect__vitest@4.0.0-beta.103.patch",
    "@legendapp/list@3.3.5": "patches/@legendapp__list@3.3.5.patch",
    "@pierre/diffs@1.3.0-beta.10": "patches/@pierre%2Fdiffs@1.3.0-beta.10.patch"
  }
}
