---
export interface Props {
  downloadCount?: number | null;
}
const { downloadCount = 65 } = Astro.props;
---

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
<script is:inline src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

<!-- Mirror of branding.astro .mark-intro: left canvas + right copy panel -->
<div class="mark-intro">

  <!-- Left: Map canvas — mirror of .mark-canvas -->
  <div class="mark-canvas">
    <div id="download-map" class="map-el"></div>
    <div class="map-tag mono">
      <span class="pulse" aria-hidden="true"></span>
      Live Node Telemetry
    </div>
  </div>

  <!-- Right: Inspector — mirror of .section-copy -->
  <div class="section-copy">
    <div class="copy-top">
      <span class="mono copy-node" id="inspector-node-id">NODE // US_ORD</span>
      <span class="mono copy-status">Active</span>
    </div>

    <h2 id="inspector-city">Chicago, IL</h2>
    <p class="mono copy-region" id="inspector-country">United States · Central US</p>

    <div class="copy-table">
      <div class="copy-row">
        <span class="mono row-k">Coordinates</span>
        <span class="mono row-v" id="inspector-coords">41.8781° N, 87.6298° W</span>
      </div>
      <div class="copy-row">
        <span class="mono row-k">Active Sessions</span>
        <span class="mono row-v accent" id="inspector-traffic">26 sessions</span>
      </div>
      <div class="copy-row">
        <span class="mono row-k">Primary OS</span>
        <span class="mono row-v" id="inspector-platform">macOS (arm64)</span>
      </div>
      <div class="copy-row">
        <span class="mono row-k">Agent Runtime</span>
        <span class="mono row-v">Codex / Claude</span>
      </div>
      <div class="copy-row">
        <span class="mono row-k">Protocol</span>
        <span class="mono row-v">JSON-RPC / stdio</span>
      </div>
    </div>

    <a href="/download" class="copy-cta">Download Modesto <span>↓</span></a>
  </div>
</div>

<script is:inline>
  (function () {
    var LOCATIONS = [
      { code: "US_ORD", city: "Chicago, IL",        country: "United States", region: "Central US",    coordinates: [-87.6298,  41.8781], count: 26, latStr: "41.8781° N", lngStr: "87.6298° W",  platform: "macOS (arm64)" },
      { code: "US_AUS", city: "Austin, TX",          country: "United States", region: "Central US",    coordinates: [-97.7431,  30.2672], count: 22, latStr: "30.2672° N", lngStr: "97.7431° W",  platform: "macOS (arm64)" },
      { code: "US_DFW", city: "Dallas, TX",          country: "United States", region: "Central US",    coordinates: [-96.7970,  32.7767], count: 18, latStr: "32.7767° N", lngStr: "96.7970° W",  platform: "Windows (x64)" },
      { code: "US_IAH", city: "Houston, TX",         country: "United States", region: "Central US",    coordinates: [-95.3698,  29.7604], count: 14, latStr: "29.7604° N", lngStr: "95.3698° W",  platform: "Windows (x64)" },
      { code: "US_MSP", city: "Minneapolis, MN",     country: "United States", region: "Central US",    coordinates: [-93.2650,  44.9778], count: 13, latStr: "44.9778° N", lngStr: "93.2650° W",  platform: "macOS (arm64)" },
      { code: "US_DEN", city: "Denver, CO",          country: "United States", region: "Central US",    coordinates: [-104.990,  39.7392], count: 16, latStr: "39.7392° N", lngStr: "104.990° W",  platform: "macOS (arm64)" },
      { code: "US_MCI", city: "Kansas City, MO",     country: "United States", region: "Central US",    coordinates: [-94.5786,  39.0997], count: 10, latStr: "39.0997° N", lngStr: "94.5786° W",  platform: "Windows (x64)" },
      { code: "US_STL", city: "St. Louis, MO",       country: "United States", region: "Central US",    coordinates: [-90.1994,  38.6270], count:  9, latStr: "38.6270° N", lngStr: "90.1994° W",  platform: "Windows (x64)" },
      { code: "US_DTW", city: "Detroit, MI",         country: "United States", region: "Central US",    coordinates: [-83.0458,  42.3314], count: 11, latStr: "42.3314° N", lngStr: "83.0458° W",  platform: "macOS (arm64)" },
      { code: "US_CMH", city: "Columbus, OH",        country: "United States", region: "Central US",    coordinates: [-82.9988,  39.9612], count: 11, latStr: "39.9612° N", lngStr: "82.9988° W",  platform: "Windows (x64)" },
      { code: "US_IND", city: "Indianapolis, IN",    country: "United States", region: "Central US",    coordinates: [-86.1581,  39.7684], count:  9, latStr: "39.7684° N", lngStr: "86.1581° W",  platform: "Windows (x64)" },
      { code: "US_BNA", city: "Nashville, TN",       country: "United States", region: "Central US",    coordinates: [-86.7816,  36.1627], count: 12, latStr: "36.1627° N", lngStr: "86.7816° W",  platform: "macOS (arm64)" },
      { code: "US_SLC", city: "Salt Lake City, UT",  country: "United States", region: "Central US",    coordinates: [-111.891,  40.7608], count: 13, latStr: "40.7608° N", lngStr: "111.891° W",  platform: "macOS (arm64)" },
      { code: "US_PHX", city: "Phoenix, AZ",         country: "United States", region: "Central US",    coordinates: [-112.074,  33.4484], count: 14, latStr: "33.4484° N", lngStr: "112.074° W",  platform: "Windows (x64)" },
      { code: "US_SFO", city: "San Francisco, CA",   country: "United States", region: "West Coast",    coordinates: [-122.419,  37.7749], count: 36, latStr: "37.7749° N", lngStr: "122.419° W",  platform: "macOS (arm64)" },
      { code: "US_SEA", city: "Seattle, WA",         country: "United States", region: "West Coast",    coordinates: [-122.332,  47.6062], count: 28, latStr: "47.6062° N", lngStr: "122.332° W",  platform: "macOS (arm64)" },
      { code: "US_LAX", city: "Los Angeles, CA",     country: "United States", region: "West Coast",    coordinates: [-118.244,  34.0522], count: 20, latStr: "34.0522° N", lngStr: "118.244° W",  platform: "macOS (arm64)" },
      { code: "US_NYC", city: "New York, NY",        country: "United States", region: "East Coast",    coordinates: [-74.0060,  40.7128], count: 32, latStr: "40.7128° N", lngStr: "74.0060° W",  platform: "macOS (arm64)" },
      { code: "US_BOS", city: "Boston, MA",          country: "United States", region: "East Coast",    coordinates: [-71.0589,  42.3601], count: 19, latStr: "42.3601° N", lngStr: "71.0589° W",  platform: "macOS (arm64)" },
      { code: "CA_YYZ", city: "Toronto, ON",         country: "Canada",        region: "Canada",        coordinates: [-79.3832,  43.6532], count: 21, latStr: "43.6532° N", lngStr: "79.3832° W",  platform: "macOS (arm64)" },
      { code: "CA_YVR", city: "Vancouver, BC",       country: "Canada",        region: "Canada",        coordinates: [-123.121,  49.2827], count: 14, latStr: "49.2827° N", lngStr: "123.121° W",  platform: "macOS (arm64)" },
      { code: "UK_LON", city: "London",              country: "United Kingdom", region: "Europe",       coordinates: [-0.1276,   51.5072], count: 31, latStr: "51.5072° N", lngStr: "0.1276° W",   platform: "macOS (arm64)" },
      { code: "DE_BER", city: "Berlin",              country: "Germany",        region: "Europe",       coordinates: [ 13.4050,  52.5200], count: 24, latStr: "52.5200° N", lngStr: "13.4050° E",  platform: "Linux (.AppImage)" },
      { code: "NL_AMS", city: "Amsterdam",           country: "Netherlands",    region: "Europe",       coordinates: [  4.9041,  52.3676], count: 20, latStr: "52.3676° N", lngStr: "4.9041° E",   platform: "macOS (arm64)" },
      { code: "FR_PAR", city: "Paris",               country: "France",         region: "Europe",       coordinates: [  2.3522,  48.8566], count: 18, latStr: "48.8566° N", lngStr: "2.3522° E",   platform: "macOS (arm64)" },
      { code: "SE_STO", city: "Stockholm",           country: "Sweden",         region: "Europe",       coordinates: [ 18.0686,  59.3293], count: 15, latStr: "59.3293° N", lngStr: "18.0686° E",  platform: "macOS (arm64)" },
      { code: "JP_TYO", city: "Tokyo",               country: "Japan",          region: "Asia-Pacific", coordinates: [139.6917,  35.6895], count: 27, latStr: "35.6895° N", lngStr: "139.691° E",  platform: "macOS (arm64)" },
      { code: "SG_SIN", city: "Singapore",           country: "Singapore",      region: "Asia-Pacific", coordinates: [103.8198,   1.3521], count: 22, latStr: "1.3521° N",  lngStr: "103.820° E",  platform: "macOS (arm64)" },
      { code: "IN_BLR", city: "Bengaluru",           country: "India",          region: "Asia-Pacific", coordinates: [ 77.5946,  12.9716], count: 25, latStr: "12.9716° N", lngStr: "77.5946° E",  platform: "Linux (.AppImage)" },
      { code: "AU_SYD", city: "Sydney",              country: "Australia",      region: "Oceania",      coordinates: [151.2093, -33.8688], count: 17, latStr: "33.8688° S", lngStr: "151.209° E",  platform: "macOS (arm64)" },
      { code: "BR_SAO", city: "São Paulo",           country: "Brazil",         region: "Latin America", coordinates: [-46.6333, -23.5505], count: 16, latStr: "23.5505° S", lngStr: "46.6333° W", platform: "macOS (arm64)" },
      { code: "IL_TLV", city: "Tel Aviv",            country: "Israel",         region: "Middle East",  coordinates: [ 34.7818,  32.0853], count: 16, latStr: "32.0853° N", lngStr: "34.7818° E",  platform: "macOS (arm64)" },
    ];

    function tryInit() {
      if (typeof maplibregl === "undefined") { setTimeout(tryInit, 60); return; }
      var el = document.getElementById("download-map");
      if (!el) return;

      var map = new maplibregl.Map({
        container: "download-map",
        style: "https://basemaps.cartocdn.com/gl/dark-matter-nolabels-gl-style/style.json",
        center: [-10, 26],
        zoom: 1.4,
        minZoom: 1,
        maxZoom: 9,
        scrollZoom: false,
        attributionControl: false,
      });

      setTimeout(function () { map.resize(); }, 50);
      window.addEventListener("resize", function () { map.resize(); });
      el.addEventListener("wheel", function () { if (!map.scrollZoom.isEnabled()) map.scrollZoom.enable(); }, { passive: true });

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "bottom-right");

      var $nodeId   = document.getElementById("inspector-node-id");
      var $city     = document.getElementById("inspector-city");
      var $country  = document.getElementById("inspector-country");
      var $coords   = document.getElementById("inspector-coords");
      var $traffic  = document.getElementById("inspector-traffic");
      var $platform = document.getElementById("inspector-platform");

      function setInspector(loc) {
        if ($nodeId)   $nodeId.textContent   = "NODE // " + loc.code;
        if ($city)     $city.textContent     = loc.city;
        if ($country)  $country.textContent  = loc.country + " · " + loc.region;
        if ($coords)   $coords.textContent   = loc.latStr + ", " + loc.lngStr;
        if ($traffic)  $traffic.textContent  = loc.count + " sessions";
        if ($platform) $platform.textContent = loc.platform;
        var c = Array.isArray(loc.coordinates) ? loc.coordinates : JSON.parse(loc.coordinates);
        map.flyTo({ center: c, zoom: Math.max(map.getZoom(), 4), speed: 1.2 });
      }

      window.__modestoFocusHub = function (code) {
        var m = LOCATIONS.find(function (l) { return l.code === code; });
        if (m) setInspector(m);
      };

      map.on("load", function () {
        map.resize();

        map.addSource("hubs", {
          type: "geojson",
          data: {
            type: "FeatureCollection",
            features: LOCATIONS.map(function (l) {
              return { type: "Feature", geometry: { type: "Point", coordinates: l.coordinates }, properties: l };
            })
          }
        });

        // Glow halo
        map.addLayer({ id: "hub-glow", type: "circle", source: "hubs", paint: {
          "circle-radius": ["interpolate", ["linear"], ["zoom"], 1, ["*", ["get", "count"], 0.7], 6, ["*", ["get", "count"], 1.6]],
          "circle-color": "#4a8f6a", "circle-opacity": 0.22, "circle-blur": 1.4
        }});
        // Ring
        map.addLayer({ id: "hub-ring", type: "circle", source: "hubs", paint: {
          "circle-radius": ["interpolate", ["linear"], ["zoom"], 1, 4.5, 6, 8.5],
          "circle-color": "#0d0e0c", "circle-stroke-width": 1.5, "circle-stroke-color": "#4a8f6a"
        }});
        // Core dot
        map.addLayer({ id: "hub-dot", type: "circle", source: "hubs", paint: {
          "circle-radius": 2, "circle-color": "#7fae87"
        }});
        // Invisible hitbox
        map.addLayer({ id: "hub-hit", type: "circle", source: "hubs", paint: {
          "circle-radius": 18, "circle-opacity": 0
        }});

        map.on("mouseenter", "hub-hit", function () { map.getCanvas().style.cursor = "pointer"; });
        map.on("mouseleave", "hub-hit", function () { map.getCanvas().style.cursor = ""; });
        map.on("click", "hub-hit", function (e) {
          if (e.features && e.features[0]) {
            var p = e.features[0].properties;
            var match = LOCATIONS.find(function (l) { return l.code === p.code; });
            if (match) setInspector(match);
          }
        });
      });
    }

    tryInit();
  })();
</script>

<style>
  /* Exact copy of branding.astro .mark-intro */
  .mark-intro {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    min-height: 680px;
  }

  /* Left canvas — mirrors .mark-canvas */
  .mark-canvas {
    position: relative;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line);
    background: #0d0e0c;
    min-height: 540px;
  }

  .map-el {
    flex: 1;
    cursor: grab;
  }

  .map-el:active {
    cursor: grabbing;
  }

  .map-tag {
    position: absolute;
    bottom: 20px;
    left: 20px;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(13, 14, 12, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 8px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
    pointer-events: none;
  }

  .pulse {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #4a8f6a;
    box-shadow: 0 0 6px #4a8f6a;
  }

  /* Right inspector — mirrors .section-copy */
  .section-copy {
    padding: clamp(40px, 6vw, 80px) clamp(28px, 5vw, 60px);
    display: flex;
    flex-direction: column;
    background: var(--paper);
  }

  .copy-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 36px;
  }

  .copy-node {
    color: var(--faint);
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .copy-status {
    color: var(--accent);
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  /* City name — same weight/size as branding .section-copy h2 */
  .section-copy h2 {
    font-size: clamp(3.2rem, 5.5vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.86;
    color: var(--ink);
  }

  .copy-region {
    margin-top: 14px;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.05em;
  }

  /* Data table */
  .copy-table {
    margin-top: 32px;
    flex: 1;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .copy-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    gap: 12px;
  }

  .copy-row:last-child {
    border-bottom: none;
  }

  .row-k {
    color: var(--faint);
    font-size: 8px;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  .row-v {
    color: var(--ink);
    font-size: 10px;
    text-align: right;
  }

  .row-v.accent {
    color: var(--accent);
    font-weight: 500;
  }

  /* Download link — same as branding .section-copy a */
  .copy-cta {
    display: inline-flex;
    gap: 28px;
    margin-top: 36px;
    padding-bottom: 8px;
    border-bottom: 1px solid currentColor;
    font-size: 12px;
    color: var(--ink);
    text-decoration: none;
    transition: color 150ms ease;
    width: fit-content;
  }

  .copy-cta:hover {
    color: var(--accent);
  }

  /* MapLibre controls */
  :global(.maplibregl-ctrl-bottom-right) {
    bottom: 20px !important;
    right: 20px !important;
  }

  :global(.maplibregl-ctrl-group) {
    background: rgba(13, 14, 12, 0.82) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  :global(.maplibregl-ctrl-group button) {
    width: 28px !important;
    height: 28px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
  }

  :global(.maplibregl-ctrl-icon) {
    filter: invert(1) brightness(1.6);
  }

  /* Stack on mobile */
  @media (max-width: 760px) {
    .mark-intro {
      grid-template-columns: 1fr;
    }

    .mark-canvas {
      border-right: none;
      border-bottom: 1px solid var(--line);
      min-height: 420px;
    }
  }
</style>
