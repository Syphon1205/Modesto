---
/*
 * Runs before first paint so the lime/paper field never flashes the wrong
 * theme. Every marketing layout includes this in <head>.
 */
---
<script is:inline>
  try {
    const theme = localStorage.getItem("modesto-theme");
    if (theme === "light") document.documentElement.dataset.theme = "light";
    if (localStorage.getItem("modesto-reduced") === "true") {
      document.documentElement.dataset.reduced = "true";
    }
  } catch {
    /* Private mode — stay on the default dark field. */
  }
</script>
