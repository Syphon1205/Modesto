---
import SquareField from "./SquareField.astro";
interface Props {
  variant?: "lattice" | "scatter" | "orbit" | "stack";
  seed?: number;
  class?: string;
}
const { variant = "lattice", seed = 7, class: className } = Astro.props;
---
<div class:list={["cube-field", className]} data-cube-field data-variant={variant} data-seed={seed} aria-hidden="true">
  <div class="cube-fallback"><SquareField seed={seed} cols={20} rows={10} /></div>
  <span class="field-coordinate">M / {String(seed).padStart(3, "0")}</span>
  <span class="field-axis">X ↗ Y ↑ Z →</span>
</div>

<style>
  .cube-field { position: relative; width: 100%; height: 100%; min-height: 120px; overflow: hidden; }
  .cube-fallback { position: absolute; inset: 0; }
  .cube-field[data-ready] .cube-fallback { visibility: hidden; }
  .field-coordinate, .field-axis { position: absolute; bottom: 18px; font: 12px "DM Mono", monospace; letter-spacing: .04em; color: var(--faint); }
  .field-coordinate { left: 22px; }
  .field-axis { right: 22px; }
</style>
