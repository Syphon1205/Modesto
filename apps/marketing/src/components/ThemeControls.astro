---
interface Props {
  pause?: boolean;
}

const { pause = false } = Astro.props;
---

<div class="float-controls">
  {pause && (
    <button class="icon-btn" id="pause-btn" type="button" aria-label="Pause animations">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <rect x="6" y="5" width="4" height="14"></rect>
        <rect x="14" y="5" width="4" height="14"></rect>
      </svg>
    </button>
  )}
  <button class="icon-btn" id="theme-btn" type="button" aria-label="Switch to light theme">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>
</div>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById("theme-btn");
  const pauseBtn = document.getElementById("pause-btn");
  const themeMeta = document.querySelector('meta[name="theme-color"]');

  const applyTheme = (theme: string) => {
    root.dataset.theme = theme;
    themeBtn?.setAttribute(
      "aria-label",
      theme === "light" ? "Switch to dark theme" : "Switch to light theme",
    );
    themeMeta?.setAttribute("content", theme === "light" ? "#efe7d6" : "#10120f");
    try {
      localStorage.setItem("modesto-theme", theme);
    } catch {
      /* ignore */
    }
  };

  applyTheme(root.dataset.theme === "light" ? "light" : "dark");

  themeBtn?.addEventListener("click", () => {
    applyTheme(root.dataset.theme === "light" ? "dark" : "light");
  });

  if (pauseBtn) {
    const applyReduced = (reduced: boolean) => {
      root.dataset.reduced = String(reduced);
      document.documentElement.style.setProperty("scroll-behavior", reduced ? "auto" : "smooth");
      pauseBtn.setAttribute("aria-label", reduced ? "Resume animations" : "Pause animations");
      try {
        localStorage.setItem("modesto-reduced", String(reduced));
      } catch {
        /* ignore */
      }
    };

    applyReduced(root.dataset.reduced === "true");
    pauseBtn.addEventListener("click", () => {
      applyReduced(root.dataset.reduced !== "true");
    });
  }
</script>
