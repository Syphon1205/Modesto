---
/*
 * SquareField — the sparse "pixel field" art that sits at the top of a card.
 *
 * Deliberately a *seeded static SVG driven by CSS animation* rather than an
 * animated <canvas>: the field only needs to shimmer, and a canvas would cost a
 * per-frame JS loop on every card for no visual gain. The same seed always
 * yields the same field, so art is stable across builds.
 *
 * Tiles fade on their own staggered cycles; a parent with .is-hoverable (set by
 * the card) pushes the accent tiles brighter and speeds the cycle up.
 */
interface Props {
  seed?: number;
  accent?: string;
  cols?: number;
  rows?: number;
  class?: string;
}

const { seed = 1, accent = "var(--accent)", cols = 30, rows = 7, class: className } = Astro.props;

// Small deterministic LCG — no Math.random(), so SSR and client agree and the
// field doesn't reshuffle on every rebuild.
let state = seed * 9301 + 49297;
const rand = () => {
  state = (state * 9301 + 49297) % 233280;
  return state / 233280;
};

const CELL = 26;
const GAP = 4;

type Tile = {
  x: number;
  y: number;
  accent: boolean;
  opacity: number;
  delay: number;
  duration: number;
};
const tiles: Tile[] = [];

for (let row = 0; row < rows; row++) {
  for (let col = 0; col < cols; col++) {
    const roll = rand();
    // Most of the grid stays empty — the sparseness is what makes it read as
    // scattered signal rather than a checkerboard.
    if (roll > 0.42) continue;
    const isAccent = rand() > 0.94;
    tiles.push({
      x: col * (CELL + GAP),
      y: row * (CELL + GAP),
      accent: isAccent,
      opacity: isAccent ? 0.32 + rand() * 0.38 : 0.03 + rand() * 0.08,
      // Long, offset cycles so no two tiles pulse in lockstep and the field
      // never reads as a single blinking grid.
      delay: -rand() * 9,
      duration: 5 + rand() * 7,
    });
  }
}

const width = cols * (CELL + GAP) - GAP;
const height = rows * (CELL + GAP) - GAP;
---

<svg
  class:list={["square-field", className]}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {
    tiles.map((tile) => (
      <rect
        class:list={["tile", { "tile-accent": tile.accent }]}
        x={tile.x}
        y={tile.y}
        width={CELL}
        height={CELL}
        fill={tile.accent ? accent : "var(--ink)"}
        style={`--o:${tile.opacity.toFixed(3)};--d:${tile.delay.toFixed(2)}s;--t:${tile.duration.toFixed(2)}s`}
      />
    ))
  }
</svg>

<style>
  .square-field {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tile {
    opacity: var(--o);
    animation: tile-breathe var(--t) ease-in-out var(--d) infinite;
  }

  /* Accent tiles swing over a wider range, so the "signal" squares are the ones
     the eye actually catches moving. */
  @keyframes tile-breathe {
    0%,
    100% {
      opacity: calc(var(--o) * 0.35);
    }
    50% {
      opacity: var(--o);
    }
  }

  /* Hover response, driven by the card: brighter, quicker. */
  :global(.square-host:hover) .tile {
    animation-duration: calc(var(--t) * 0.55);
  }

  :global(.square-host:hover) .tile-accent {
    opacity: calc(var(--o) * 1.6);
  }

  .tile-accent {
    transition: opacity 320ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    :global(.square-host:hover) .tile {
      animation: none;
    }
  }
</style>
