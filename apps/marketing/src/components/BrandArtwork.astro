---
/*
 * Per-post cover art.
 *
 * Every card used to render the same three tiles (Codex / Claude / Cursor) in
 * one of three near-identical layouts, so a page of posts read as one repeated
 * illustration. Everything here is now derived from `variant`: which agents
 * appear, which finish each tile takes, how the group is arranged, and the
 * tilt of the orbit. With 16 marks and 4 layouts, no two adjacent posts match.
 *
 * The tiles use the shared .app-tile / .mark primitives, so the blog speaks the
 * same shape language as the hero orbit rather than inventing its own.
 */
interface Props {
  variant?: number;
  label?: string;
}
const { variant = 0, label = "Modesto / context carried forward" } = Astro.props;

const MARKS = [
  "codex", "claude", "cursor", "gemini", "grok", "opencode", "copilot", "droid",
  "kilo", "kimi", "qwen", "poolside", "devin", "pi", "meta", "acp",
];

// Three different agents per card, walked around the list so consecutive
// variants never share one.
const step = Math.abs(variant) % MARKS.length;
const marks = [0, 1, 2].map((i) => MARKS[(step * 3 + i * 5) % MARKS.length]);

// Rotate which tile carries the lime, the paper and the dark case.
const FINISHES = ["lime", "dark", "paper"];
const finishes = [0, 1, 2].map((i) => FINISHES[(i + variant) % FINISHES.length]);

const layout = Math.abs(variant) % 4;
---

<div class:list={["brand-artwork", `layout-${layout}`]} aria-hidden="true">
  <span class="art-orbit" style={`--tilt:${-28 + layout * 14}deg`}></span>
  {
    marks.map((slug, index) => (
      <span class:list={["app-tile", "art-tile", `slot-${index}`, finishes[index]]}>
        <span class="mark" style={`--mark:url(/brand/marks/${slug}.svg)`} />
      </span>
    ))
  }
  <span class="art-label mono">{label}</span>
</div>

<style>
  .brand-artwork {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 230px;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(ellipse 80% 70% at 50% 24%, var(--card-2), var(--bg-2) 72%);
  }

  .art-orbit {
    position: absolute;
    left: 20%;
    top: 20%;
    width: 58%;
    height: 52%;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: 50%;
    transform: rotate(var(--tilt));
  }

  /*
   * Scoped under .brand-artwork so these beat the shared .app-tile rule, which
   * sets `position: relative` — without the extra specificity the tiles ignore
   * their slot offsets and stack in the corner.
   */
  .brand-artwork .art-tile {
    position: absolute;
    width: 32%;
    max-width: 92px;
  }
  .brand-artwork .slot-0 { left: 14%; top: 20%; transform: rotate(-13deg); }
  .brand-artwork .slot-1 { left: 40%; top: 11%; transform: rotate(8deg); z-index: 2; }
  .brand-artwork .slot-2 { left: 55%; top: 43%; transform: rotate(-7deg); z-index: 3; }

  .brand-artwork.layout-1 .slot-0 { left: 18%; top: 38%; transform: rotate(7deg); }
  .brand-artwork.layout-1 .slot-1 { left: 44%; top: 13%; transform: rotate(-9deg); }
  .brand-artwork.layout-1 .slot-2 { left: 61%; top: 41%; transform: rotate(12deg); }

  .brand-artwork.layout-2 .slot-0 { left: 11%; top: 31%; transform: rotate(6deg); }
  .brand-artwork.layout-2 .slot-1 { left: 37%; top: 42%; transform: rotate(-11deg); }
  .brand-artwork.layout-2 .slot-2 { left: 62%; top: 17%; transform: rotate(11deg); }

  .brand-artwork.layout-3 .slot-0 { left: 21%; top: 13%; transform: rotate(9deg); }
  .brand-artwork.layout-3 .slot-1 { left: 49%; top: 33%; transform: rotate(-6deg); }
  .brand-artwork.layout-3 .slot-2 { left: 28%; top: 45%; transform: rotate(14deg); }

  /* Three finishes, matching the 3D: lime, dark glass, cream paper. */
  .art-tile.lime { background: var(--accent); border-color: transparent; }
  .art-tile.lime > .mark { color: #14180f; }
  .art-tile.dark { background: linear-gradient(150deg, #3a4335, #1b2118); }
  .art-tile.dark > .mark { color: #eceee6; }
  .art-tile.paper { background: linear-gradient(150deg, #f5f1e6, #c3c9b6); border-color: transparent; }
  .art-tile.paper > .mark { color: #14180f; }

  .art-label {
    position: absolute;
    left: 20px;
    bottom: 16px;
    color: var(--fg-dim);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .brand-artwork { min-height: 190px; }
    .art-tile { width: 30%; }
  }
</style>
