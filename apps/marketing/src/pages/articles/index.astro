---
import Layout from "../../layouts/ResourceLayout.astro";
import BrandArtwork from "../../components/BrandArtwork.astro";

const POSTS = [
  {
    slug: "agent-autonomy",
    title: "How much autonomy should an agent have?",
    excerpt: "Autonomy is not a slider from 'assistant' to 'agent'. It is a set of separate decisions — what it may read, change, run, and merge — and they are worth setting deliberately.",
    category: "Research",
    author: "Modesto Team",
    date: "September 5, 2026",
    cover: "/blog-agent-autonomy.svg",
    featured: false,
  },
  {
    slug: "what-is-a-harness",
    title: "What is a harness?",
    excerpt: "If you want an AI agent to write code for you, you need to give it a place to work. Why pure functions, clear boundaries, and determinism matter more than ever.",
    category: "Engineering",
    author: "Modesto Team",
    date: "August 17, 2026",
    cover: "/blog-what-is-a-harness.svg",
    featured: false,
  },
  {
    slug: "code-plus-work",
    title: "Code + Work are now one workspace.",
    excerpt: "How Modesto collapsed the gap between writing code with AI agents and actually shipping work. An argument for unified workspace design.",
    category: "Product",
    author: "Modesto Team",
    date: "August 17, 2026",
    cover: "/blog-code-plus-work.svg",
    featured: true,
  },
  {
    slug: "checkpoints",
    title: "Checkpoints are how work survives.",
    excerpt: "When you close an agent session, context evaporates. A checkpoint is the structured artifact that makes it not.",
    category: "Engineering",
    author: "Modesto Team",
    date: "August 15, 2026",
    cover: "/blog-checkpoints.svg",
    featured: false,
  },
  {
    slug: "650-sessions",
    title: "650 sessions. 25 cities.",
    excerpt: "The milestone, what the numbers actually mean, and why Central US became the unexpected epicenter of early Modesto usage.",
    category: "Milestone",
    author: "Modesto Team",
    date: "August 14, 2026",
    cover: "/blog-650-sessions.svg",
    featured: false,
  },
  {
    slug: "every-agent",
    title: "Every agent. One workspace.",
    excerpt: "Modesto runs Codex, Claude Code, OpenCode, Gemini, and any stdio-compatible agent from one workspace. Here's why the architecture works this way.",
    category: "Product",
    author: "Modesto Team",
    date: "August 12, 2026",
    cover: "/blog-every-agent.svg",
    featured: false,
  },
];

const CATEGORIES = ["Latest", "Research", "Product", "Engineering", "Announcement", "Milestone"];
---

<Layout
  title="Blog — Modesto"
  description="Writing from the Modesto team on AI agents, local-first software, and the future of development work."
>
  <div class="blog-shell">

    <!-- Left sidebar -->
    <aside class="blog-sidebar">
      <div class="sidebar-sticky">
        <p class="mono">MODESTO / FIELD NOTES</p>
        <h1 class="sidebar-title">Ideas behind the work.</h1>
        <p class="sidebar-sub">Building a better home for agents. Notes on the product, the craft, and what comes next.</p>
        <nav class="sidebar-nav" aria-label="Blog categories">
          {CATEGORIES.map((cat, i) => (
            <a
              href={`#${cat.toLowerCase().replace(/\s+/g, '-')}`}
              class:list={["sidebar-link", { active: i === 0 }]}
            >
              {cat}
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Right: featured cards, then category-grouped rows -->
    <div class="blog-feed" id="latest">
      <div class="feature-row">
        {POSTS.filter((p) => p.featured).concat(POSTS.filter((p) => !p.featured).slice(0, 2)).map((post, index) => (
          <a href={`/articles/${post.slug}`} class="feature-card" data-category={post.category}>
            <div class="feature-art">
              <BrandArtwork variant={index} label={`Modesto / ${post.category}`} />
            </div>
            <div class="feature-meta">
              <span class="feature-tag">{post.category}</span>
              <span class="mono">{post.date}</span>
            </div>
            <h2>{post.title}</h2>
            <p class="feature-excerpt">{post.excerpt}</p>
          </a>
        ))}
      </div>

      {
        CATEGORIES.filter((cat) => cat !== "Latest").map((cat) => {
          const posts = POSTS.filter((post) => post.category === cat);
          return posts.length === 0 ? null : (
            <section class="post-group" id={cat.toLowerCase().replace(/\s+/g, "-")}>
              <h3 class="group-label">{cat}</h3>
              <div class="group-rows">
                {posts.map((post) => (
                  <a href={`/articles/${post.slug}`} class="post-row" data-category={post.category}>
                    <span class="row-title">{post.title}</span>
                    <span class="row-date mono">{post.date}</span>
                  </a>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>

  </div>
</Layout>

<script>
  // Category filter. Rows live inside per-category groups, so filtering hides
  // whole groups; feature cards are filtered individually by their own category.
  const links = document.querySelectorAll<HTMLAnchorElement>(".sidebar-link");
  const groups = document.querySelectorAll<HTMLElement>(".post-group");
  const features = document.querySelectorAll<HTMLElement>(".feature-card");

  const applyFilter = (filter: string) => {
    groups.forEach((group) => {
      const label = group.querySelector(".group-label")?.textContent?.trim();
      group.hidden = filter !== "Latest" && label !== filter;
    });
    features.forEach((card) => {
      card.hidden = filter !== "Latest" && card.getAttribute("data-category") !== filter;
    });
  };

  const activate = (link: HTMLAnchorElement) => {
    links.forEach((other) => other.classList.toggle("active", other === link));
    applyFilter(link.textContent?.trim() ?? "Latest");
  };

  links.forEach((link) => {
    link.addEventListener("click", (event) => {
      // These filter in place. Letting the anchor navigate made the page jump to
      // a section that the filter was about to hide, which read as a random
      // scroll. Keep the URL shareable, lose the jump.
      event.preventDefault();
      activate(link);
      history.replaceState(null, "", link.getAttribute("href") ?? location.pathname);
    });
  });

  if (window.location.hash) {
    const target = document.querySelector<HTMLAnchorElement>(
      `.sidebar-link[href="${window.location.hash}"]`,
    );
    if (target) activate(target);
  }
</script>


