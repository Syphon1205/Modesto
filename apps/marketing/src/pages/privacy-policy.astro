import LegalPage from "../components/LegalPage.astro";

const sections = [
  ["introduction", "Introduction"],
  ["information", "Personal information we collect"],
  ["uses", "How we use your personal information"],
  ["sharing", "How we share your personal information"],
  ["choices", "Your choices regarding your personal information"],
  ["security", "Security of your personal information"],
