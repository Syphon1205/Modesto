---
import Layout from "../layouts/ResourceLayout.astro";
import DownloadMap from "../components/DownloadMap.astro";
import { fetchTotalDownloads, REPO_URL } from "../lib/releases";

let totalDownloads: number | null = null;
try {
  totalDownloads = await fetchTotalDownloads();
} catch {}

const displayTotal = totalDownloads !== null ? totalDownloads : "—";

const HUBS = [
  { code: "US_ORD", city: "Chicago, IL", region: "Central US", sessions: "26 sessions", os: "macOS" },
  { code: "US_AUS", city: "Austin, TX", region: "Central US", sessions: "22 sessions", os: "macOS" },
  { code: "US_DFW", city: "Dallas, TX", region: "Central US", sessions: "18 sessions", os: "Windows" },
  { code: "US_DEN", city: "Denver, CO", region: "Central US", sessions: "16 sessions", os: "macOS" },
  { code: "US_IAH", city: "Houston, TX", region: "Central US", sessions: "14 sessions", os: "Windows" },
  { code: "US_MSP", city: "Minneapolis, MN", region: "Central US", sessions: "13 sessions", os: "macOS" },
  { code: "US_BNA", city: "Nashville, TN", region: "Central US", sessions: "12 sessions", os: "macOS" },
  { code: "US_DTW", city: "Detroit, MI", region: "Central US", sessions: "11 sessions", os: "macOS" },
  { code: "US_SLC", city: "Salt Lake City, UT", region: "Central US", sessions: "13 sessions", os: "macOS" },
  { code: "US_PHX", city: "Phoenix, AZ", region: "Central US", sessions: "14 sessions", os: "Windows" },
  { code: "US_SFO", city: "San Francisco, CA", region: "West Coast", sessions: "36 sessions", os: "macOS" },
  { code: "US_SEA", city: "Seattle, WA", region: "West Coast", sessions: "28 sessions", os: "macOS" },
  { code: "US_NYC", city: "New York, NY", region: "East Coast", sessions: "32 sessions", os: "macOS" },
  { code: "US_BOS", city: "Boston, MA", region: "East Coast", sessions: "19 sessions", os: "macOS" },
  { code: "CA_YYZ", city: "Toronto, ON", region: "Canada", sessions: "21 sessions", os: "macOS" },
  { code: "UK_LON", city: "London, UK", region: "Europe", sessions: "31 sessions", os: "macOS" },
  { code: "DE_BER", city: "Berlin, DE", region: "Europe", sessions: "24 sessions", os: "Linux" },
  { code: "NL_AMS", city: "Amsterdam, NL", region: "Europe", sessions: "20 sessions", os: "macOS" },
  { code: "FR_PAR", city: "Paris, FR", region: "Europe", sessions: "18 sessions", os: "macOS" },
  { code: "JP_TYO", city: "Tokyo, JP", region: "Asia-Pacific", sessions: "27 sessions", os: "macOS" },
  { code: "SG_SIN", city: "Singapore, SG", region: "Asia-Pacific", sessions: "22 sessions", os: "macOS" },
  { code: "IN_BLR", city: "Bengaluru, IN", region: "Asia-Pacific", sessions: "25 sessions", os: "Linux" },
  { code: "AU_SYD", city: "Sydney, AU", region: "Oceania", sessions: "17 sessions", os: "macOS" },
  { code: "BR_SAO", city: "São Paulo, BR", region: "Latin America", sessions: "16 sessions", os: "macOS" },
  { code: "IL_TLV", city: "Tel Aviv, IL", region: "Middle East", sessions: "16 sessions", os: "macOS" },
];
---

<Layout
  title="Global Reach — Modesto"
  description="The global footprint of developers using local-first coding agents."
>

  <section class="brand-hero">
    <p class="mono">Modesto / Global reach</p>
    <h1>Where work<br />moves.</h1>
    <div class="hero-note">
      <span class="mono">{displayTotal} installer downloads · illustrative map</span>
      <p>The original Modesto community map. City markers and session counts are illustrative, not live usage data.</p>
    </div>
  </section>

  <nav class="brand-index" aria-label="Page sections">
    <a href="#stage">Live map</a>
    <a href="#directory">Active directory</a>
    <a href="#policy">Network policy</a>
    <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
  </nav>

  <!-- 01: Map Stage — mirror of .mark-intro split layout -->
  <section class="brand-section" id="stage">
    <div class="section-kicker">
      <span class="mono">01</span>
      <span>Live Map</span>
      <span class="mono">{displayTotal} installer downloads</span>
    </div>
    <DownloadMap downloadCount={totalDownloads} />
  </section>

  <!-- 02: Directory — mirror of .type-grid split approach -->
  <section class="brand-section" id="directory">
    <div class="section-kicker">
      <span class="mono">02</span>
      <span>Active Regional Hubs</span>
      <span class="mono">25 Nodes</span>
    </div>
    <div class="dir-intro">
      <h2>Verified regional nodes</h2>
      <p>Click any row to fly the map to that city and inspect its telemetry, runtime, and agent configuration.</p>
    </div>
    <div class="dir-table">
      <div class="dir-head">
        <span class="mono">Node</span>
        <span class="mono">Location</span>
        <span class="mono">Region</span>
        <span class="mono">OS</span>
        <span class="mono">Activity</span>
      </div>
      <div class="dir-body">
        {HUBS.map((hub) => (
          <div
            class="dir-row"
            role="button"
            tabindex="0"
            onclick={`if(window.__modestoFocusHub){window.__modestoFocusHub('${hub.code}');document.getElementById('stage').scrollIntoView({behavior:'smooth'})}`}
          >
            <span class="mono t-code">{hub.code}</span>
            <span class="t-city">{hub.city}</span>
            <span class="mono t-region">{hub.region}</span>
            <span class="mono t-os">{hub.os}</span>
            <span class="mono t-sessions">{hub.sessions}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03: Policy — direct copy of .mark-rules layout -->
  <section class="brand-section" id="policy">
    <div class="section-kicker">
      <span class="mono">03</span>
      <span>Network Architecture</span>
      <span class="mono">Local-First</span>
    </div>
    <div class="mark-rules">
      <div>
        <span class="mono">01 / Local-First</span>
        <p>Zero cloud prompt routing. Session prompts, files, code diffs, and credentials never leave the local machine.</p>
      </div>
      <div>
        <span class="mono">02 / Open Protocols</span>
        <p>Standard JSON-RPC over stdio runs directly against local CLI agents — Codex, Claude Code, OpenCode, Gemini.</p>
      </div>
      <div>
        <span class="mono">03 / Universal Checkpoints</span>
        <p>Workspaces stay deterministic and portable between teammates through standard Git branches and handoffs.</p>
      </div>
    </div>
  </section>

  <!-- End — exact copy of branding.astro .brand-end -->
  <section class="brand-end">
    <img src="/modesto-logo.svg" alt="" />
    <h2>Every agent.<br />One shared context.</h2>
    <a href="/download">Download Modesto <span>↓</span></a>
  </section>

</Layout>

<style>
  /* Exact same container rules as branding.astro */
  .brand-hero,
  .brand-section,
  .brand-index,
  .brand-end {
    width: min(100% - 48px, 1440px);
    margin: 0 auto;
    border-inline: 1px solid var(--line);
  }

  /* Hero — same as branding.astro */
  .brand-hero {
    min-height: 690px;
    padding: clamp(120px, 15vw, 220px) clamp(28px, 8vw, 120px) 70px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: radial-gradient(ellipse 60% 45% at 50% -10%, color-mix(in srgb, var(--violet) 14%, transparent), transparent 68%);
  }

  .brand-hero > .mono {
    color: var(--faint);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .brand-hero h1 {
    max-width: 1150px;
    margin: 100px 0;
    font-size: clamp(5.3rem, 13vw, 12.5rem);
    font-weight: 500;
    letter-spacing: -0.09em;
    line-height: 0.77;
    color: var(--ink);
  }

  .hero-note {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: end;
  }

  .hero-note > span {
    color: var(--faint);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .hero-note p {
    max-width: 430px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }

  /* Sub-nav — same as branding.astro */
  .brand-index {
    min-height: 66px;
    display: flex;
    gap: clamp(20px, 4vw, 64px);
    align-items: center;
    padding: 0 28px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: auto;
  }

  .brand-index a {
    flex: none;
    color: var(--muted);
    font-size: 12px;
    transition: color 150ms ease;
  }

  .brand-index a:hover {
    color: var(--ink);
  }

  /* Section container — same as branding.astro */
  .brand-section {
    border-bottom: 1px solid var(--line);
  }

  .section-kicker {
    height: 52px;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font-size: 10px;
  }

  .section-kicker .mono {
    font-size: 8px;
  }

  /* Directory intro — mirrors .section-copy */
  .dir-intro {
    padding: clamp(45px, 7vw, 100px) clamp(28px, 8vw, 100px);
  }

  .dir-intro h2 {
    font-size: clamp(3.5rem, 6vw, 6.6rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.86;
    color: var(--ink);
  }

  .dir-intro p {
    max-width: 450px;
    margin-top: 32px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  /* Directory table */
  .dir-table {
    border-top: 1px solid var(--line);
  }

  .dir-head {
    display: grid;
    grid-template-columns: 120px 1.5fr 1fr 100px 120px;
    padding: 14px 28px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper-deep) 60%, transparent);
    color: var(--faint);
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .dir-body {
    display: flex;
    flex-direction: column;
  }

  .dir-row {
    display: grid;
    grid-template-columns: 120px 1.5fr 1fr 100px 120px;
    align-items: center;
    padding: 18px 28px;
    border-bottom: 1px solid var(--line);
    background: transparent;
    cursor: pointer;
    color: var(--ink);
    font-size: 13px;
    transition: background 120ms ease;
  }

  .dir-row:last-child {
    border-bottom: none;
  }

  .dir-row:hover {
    background: color-mix(in srgb, var(--paper-deep) 80%, transparent);
  }

  .t-code {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .t-city {
    color: var(--ink);
    font-weight: 500;
  }

  .t-region {
    color: var(--muted);
    font-size: 11px;
  }

  .t-os {
    color: var(--faint);
    font-size: 11px;
  }

  .t-sessions {
    color: var(--accent);
    font-size: 11px;
    text-align: right;
  }

  /* Policy cards — exact copy of branding.astro .mark-rules */
  .mark-rules {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }

  .mark-rules > div {
    min-height: 220px;
    padding: 30px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .mark-rules > div:last-child {
    border-right: 0;
  }

  .mark-rules span {
    color: var(--faint);
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .mark-rules p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
  }

  /* End CTA — exact copy of branding.astro .brand-end */
  .brand-end {
    min-height: 600px;
    padding: clamp(60px, 10vw, 150px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    border-bottom: 1px solid var(--line);
    background: var(--dark);
    color: #f3f0e8;
  }

  .brand-end img {
    width: 70px;
    filter: invert(1);
  }

  .brand-end h2 {
    margin-top: 60px;
    font-size: clamp(4.5rem, 10vw, 10rem);
    font-weight: 500;
    letter-spacing: -0.09em;
    line-height: 0.8;
    color: #f3f0e8;
  }

  .brand-end a {
    display: inline-flex;
    gap: 28px;
    margin-top: 58px;
    padding-bottom: 8px;
    border-bottom: 1px solid currentColor;
    font-size: 12px;
    color: #f3f0e8;
    transition: opacity 150ms ease;
  }

  .brand-end a:hover {
    opacity: 0.75;
  }

  .brand-end a span {
    margin-left: 28px;
  }

  /* Responsive */
  @media (max-width: 760px) {
    .brand-hero,
    .brand-section,
    .brand-index,
    .brand-end {
      width: min(100% - 32px, 1440px);
    }

    .brand-hero {
      min-height: 590px;
      padding-inline: 28px;
    }

    .brand-hero h1 {
      margin: 70px 0;
      font-size: clamp(4.3rem, 18vw, 7rem);
    }

    .hero-note {
      grid-template-columns: 1fr;
    }

    .mark-rules {
      grid-template-columns: 1fr;
    }

    .mark-rules > div {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .dir-head,
    .dir-row {
      grid-template-columns: 90px 1.2fr 100px;
      padding-inline: 16px;
    }

    .t-region,
    .t-os {
      display: none;
    }

    .brand-end {
      min-height: 500px;
      padding: 48px 28px;
    }

    .brand-end h2 {
      font-size: clamp(4.3rem, 17vw, 7rem);
    }
  }
</style>
