---
import "../styles/brand-preview.css";
import SiteFooter from "../components/SiteFooter.astro";
import IslandNav from "../components/IslandNav.astro";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeControls from "../components/ThemeControls.astro";

const agents = [
  ["claude", "Claude"],
  ["codex", "Codex"],
  ["cursor", "Cursor"],
  ["gemini", "Gemini"],
  ["opencode", "OpenCode"],
  ["meta", "Meta"],
  ["grok", "Grok"],
  ["droid", "Droid"],
] as const;

const quotes = [
  {
    handle: "pocarles",
    text: "The interface between you and the model changes everything.",
    name: "pocarles",
  },
  {
    handle: "teja2495",
    text: "I’ve completely switched to Modesto for all my workflows.",
    name: "teja2495",
  },
  {
    handle: "leodev",
    text: "The first coding GUI that didn’t suck performance-wise.",
    name: "leodev",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {Astro.url.pathname !== "/" && <meta name="robots" content="noindex,nofollow" />}
    <meta
      name="description"
      content="Every agent. One workspace. Claude, Codex, Cursor and the rest — on your own subscriptions, in one place that keeps the thread."
    />
    <title>Modesto — Every agent. One workspace.</title>
    <link
      rel="preload"
      href="/announcements/modesto-saas-assets/vendor/manrope.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta name="theme-color" content="#10120f" />
    <ThemeBoot />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>

    <IslandNav />

    <main id="main">
      <section class="ship" id="top" aria-labelledby="ship-title">
        <div class="ship-stage" id="ring-stage"></div>
        <div class="mobile-agent-strip" aria-hidden="true">
          {agents.slice(0, 5).map(([slug]) => <img src={`/brand/marks/${slug}.svg`} alt="" width="24" height="24" />)}
        </div>
        {/*
          Headline and buttons only. The orbit is already busy, and a kicker,
          a lede and a stat row stacked inside it left nothing for the eye to
          land on. The supporting copy and the numbers live further down the
          page, where they have room.
        */}
        <div class="ship-copy">
          <h1 id="ship-title">Ship faster.</h1>
          <div class="ship-actions">
            <a class="btn btn-primary btn-lg" href="/download">Download for macOS</a>
            <a class="btn btn-secondary btn-lg" href="#playground">See the handoff</a>
          </div>
        </div>
      </section>

      <section id="playground" aria-label="Interactive agent demonstration">
        <div class="relay" id="relay">
          <div class="relay-bar">
            <span class="mark" style="--mark:url(/announcements/modesto-mark-light.svg)"></span>
            <span class="relay-title">modesto</span>
            <span class="relay-branch">feat/composer-nav</span>
            <span class="relay-run">RUN AF_0418</span>
            <button class="relay-replay" id="relay-replay" type="button">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
              <span id="relay-replay-label">Replay</span>
            </button>
          </div>

          <div class="relay-brief">
            <span class="kicker is-dim no-dot">The brief</span>
            <p>
              Add keyboard navigation to the composer. Reuse the existing
              disclosure motion. Open a draft PR when it&rsquo;s good.
            </p>
          </div>

          <ol class="relay-lanes" id="relay-lanes"></ol>

          <div class="relay-foot">
            <span class="relay-thread">
              <i></i> One thread · three agents · context carried forward
            </span>
            <span class="relay-elapsed" id="relay-elapsed">READY</span>
          </div>
        </div>
        <p class="playground-caption">
          One brief. Three agents. The thread never restarts.
        </p>

        <div class="feature-grid" id="agents">
          <article class="feature">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M16 18 22 12 16 6"/><path d="M8 6 2 12 8 18"/></svg>
            <h3>Many agents</h3>
            <p>Use Claude, Codex, Cursor, OpenCode, or Grok from one surface. Switch mid-thread when the work asks for it.</p>
            <a href="#harness">Explore ↗</a>
          </article>
          <article class="feature">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6M9 12h6M9 15h3"/></svg>
            <h3>Your tools</h3>
            <p>Keep the subscriptions you already pay for. Modesto orchestrates the work. Nobody resells you tokens.</p>
            <a href="#source">Explore ↗</a>
          </article>
          <article class="feature">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h7l7 7v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M13 3v6h6"/></svg>
            <h3>Your projects</h3>
            <p>Every thread keeps its files, history, and branch. Pause a run and pick it up without starting over.</p>
            <a href="#workspace">Explore ↗</a>
          </article>
        </div>

        <div class="pillars">
          <div class="pillar"><strong>Any model</strong><span>Keep your choice of intelligence</span></div>
          <div class="pillar"><strong>Every thread</strong><span>An inspectable execution history</span></div>
          <div class="pillar"><strong>Your subs</strong><span>Connected through the CLIs you already use</span></div>
          <div class="pillar"><strong>One workspace</strong><span>Context that carries forward</span></div>
        </div>
      </section>

      <div class="film-knot-stage" id="film-knot-stage" aria-hidden="true"></div>

      <section class="logo-band" aria-label="Supported coding agents">
        <p class="small-label">Fifteen agents. One workspace. Bring your own subscription.</p>
        <div class="logo-row">
          {agents.map(([slug, name]) => (
            <div class="logo-cell">
              <span class="mark" style={`--mark:url(/brand/marks/${slug}.svg)`}></span>
              <span>{name}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="product" id="harness" aria-labelledby="harness-title">
        <div class="product-header">
          <p class="section-index">#01 / The agent harness</p>
          <h2 id="harness-title">From an instruction to work you can use.</h2>
        </div>
        <div class="product-body">
          <div class="product-tabs" role="tablist" aria-label="Harness capabilities">
            <button class="product-tab" type="button" role="tab" aria-selected="true" data-panel="sdk">
              <strong>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 19h8"/><path d="m4 17 6-6-6-6"/></svg>
                Agent surface
              </strong>
              <span>Describe the job, pick an agent, and send the first message. No orchestration maze.</span>
            </button>
            <button class="product-tab" type="button" role="tab" aria-selected="false" data-panel="context">
              <strong>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h6"/></svg>
                Persistent context
              </strong>
              <span>Carry useful context between runs. Your agent should learn the job, not relearn the brief.</span>
            </button>
            <button class="product-tab" type="button" role="tab" aria-selected="false" data-panel="git">
              <strong>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="6" cy="6" r="2.2"/><circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M6 8v8M18 8v5a3 3 0 01-3 3h-3"/></svg>
                Git that ships
              </strong>
              <span>Each thread writes to its own branch. When it’s good, one button opens the PR.</span>
            </button>
          </div>
          <div class="editor" id="editor">
            <div class="editor-head">
              <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span id="editor-title">composer.md</span>
              <button class="editor-copy" id="copy-code" type="button" aria-label="Copy code example">Copy</button>
            </div>
            <div class="editor-body">
              <div class="lang-tabs" role="tablist" aria-label="Example language">
                <button class="lang-tab" type="button" role="tab" aria-selected="true" data-lang="md">Md Markdown</button>
                <button class="lang-tab" type="button" role="tab" aria-selected="false" data-lang="ts">Ts TypeScript</button>
              </div>
              <pre id="editor-code"></pre>
            </div>
            <div class="product-footer" id="editor-foot">Example composer · Bring your own model</div>
          </div>
        </div>
        <div class="product-footer"><a href="#workspace">Explore the agent runtime ↗</a></div>
      </section>

      <section class="journey" aria-labelledby="journey-title">
        <div class="section-copy">
          <div>
            <p class="eyebrow">One run. Nothing lost along the way.</p>
            <h2 id="journey-title">One instruction. A connected chain of work.</h2>
          </div>
          <p>The brief becomes a plan. The plan becomes a pull request.</p>
        </div>
        <div class="journey-board" id="journey-board">
          <article class="board-card">
            <small>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V5a2 2 0 0 1 2-2h7l7 7v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/></svg>
              <span id="board-in-title">brief.md</span>
            </small>
            <p id="board-in">What should we change in the composer this week?</p>
            <footer id="board-in-foot">One clear outcome →</footer>
          </article>
          <div class="board-mid" aria-hidden="true">
            <span class="chip">Search</span>
            <span class="tool-mark">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </span>
            <span class="chip" id="board-mid-chip">Write ✓</span>
          </div>
          <article class="board-card">
            <small>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              <span id="board-out-title">composer-nav.tsx</span>
            </small>
            <p id="board-out">01 The current path<br />02 The change<br />03 The PR</p>
            <footer id="board-out-foot">✓ Saved to your workspace</footer>
          </article>
        </div>
        <div class="journey-tabs" role="tablist">
          <button class="journey-tab" type="button" role="tab" aria-selected="true" data-step="0"><b>01 Define the job</b></button>
          <button class="journey-tab" type="button" role="tab" aria-selected="false" data-step="1"><b>02 Connect the work</b></button>
          <button class="journey-tab" type="button" role="tab" aria-selected="false" data-step="2"><b>03 Keep the result</b></button>
        </div>
        <div class="journey-copy">
          <p id="journey-text">Start with an outcome, not a script. Give your agent the brief and the boundaries; it can work out the next useful step.</p>
          <span class="meta" id="journey-meta">Input / brief.md</span>
        </div>
      </section>

      <section class="workspace" id="workspace" aria-labelledby="workspace-title">
        <div class="section-copy">
          <div>
            <p class="eyebrow">The next run starts with what you already know.</p>
            <h2 id="workspace-title">Separate workspaces. A shared foundation.</h2>
          </div>
          <p>Give each project its own files, memory, and permissions. Keep the right context close, and everything else out of the way.</p>
        </div>
        <div class="workspace-visual">
          <div class="workspace-window">
            <div class="editor-head">
              <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>modesto / workspace</span>
            </div>
            <div class="workspace-layout">
              <div class="workspace-tree">
                <div class="tree-label">Project files</div>
                <button class="workspace-file" type="button" data-file="brief" aria-pressed="true">brief.md</button>
                <button class="workspace-file" type="button" data-file="thread" aria-pressed="false">thread.json</button>
                <button class="workspace-file" type="button" data-file="diff" aria-pressed="false">composer.tsx</button>
                <button class="workspace-file" type="button" data-file="pr" aria-pressed="false">pull-request.md</button>
              </div>
              <div>
                <div class="workspace-file-content" id="file-content"></div>
                <div class="workspace-status">
                  <span id="file-status">brief.md saved</span>
                  <span>3 files in this run · project scope</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="use-cases" aria-labelledby="usecase-title">
        <p class="eyebrow">A closer look at durable runs</p>
        <h2 id="usecase-title">Put agents to work across your team.</h2>
        <p class="lede">Different tasks. The same tools, context, and room to get the work done.</p>
        <div class="case-grid">
          <article class="case">
            <small>01</small>
            <h3>Research & strategy</h3>
            <p>Give the next decision a useful starting point.</p>
            <ul>
              <li>— Compare sources and document the tradeoffs.</li>
              <li>— Turn the findings into a clear decision brief.</li>
            </ul>
            <code>research-brief.md</code>
          </article>
          <article class="case">
            <small>02</small>
            <h3>Product & engineering</h3>
            <p>Take a focused change from the brief to review.</p>
            <ul>
              <li>— Read the code and follow its conventions.</li>
              <li>— Implement the change and check the details.</li>
            </ul>
            <code>command-menu.tsx</code>
          </article>
          <article class="case">
            <small>03</small>
            <h3>Review & ship</h3>
            <p>Turn a finished thread into a pull request.</p>
            <ul>
              <li>— Read the diff before anything leaves the machine.</li>
              <li>— Open the PR with a generated title and body.</li>
            </ul>
            <code>feat/composer-nav</code>
          </article>
        </div>
      </section>

      <section class="control" id="source" aria-labelledby="control-title">
        <div class="product-header">
          <p class="section-index">#02 / Stay in control</p>
          <h2 id="control-title">Let agents get on with it. Stay in control.</h2>
        </div>
        <div class="control-body">
          <div class="control-visual">
            <div class="perm-card">
              <header>
                <span>Thread permissions</span>
                <span>af_run_0418</span>
              </header>
              <div class="step"><i></i><div><b>01 / The task</b><p>Prepare the composer change</p></div></div>
              <div class="step"><i></i><div><b>02 / The work</b><p>Three tools allowed for this run.</p></div></div>
              <div class="step"><i></i><div><b>03 / Your call</b><p>The draft is ready. You decide when it goes out.</p></div></div>
              <button class="approve" id="approve" type="button">Approve publish</button>
            </div>
          </div>
          <div class="product-tabs" role="tablist" aria-label="Control surfaces">
            <button class="product-tab" type="button" role="tab" aria-selected="true">
              <strong>Tool permissions</strong>
              <span>Let routine actions run freely. Give sensitive tools their own permissions, without slowing everything else down.</span>
            </button>
            <button class="product-tab" type="button" role="tab" aria-selected="false">
              <strong>Human approvals</strong>
              <span>Pause before the decisions you want to review. Approve the next step and let the agent carry on from there.</span>
            </button>
            <button class="product-tab" type="button" role="tab" aria-selected="false">
              <strong>Execution history</strong>
              <span>See the inputs, tool calls, and decisions behind each run. Pick up the thread without digging through scattered logs.</span>
            </button>
          </div>
        </div>
      </section>

      <section class="quotes" aria-label="Example customer stories">
        {quotes.map((quote) => (
          <blockquote class="quote">
            <p>“{quote.text}”</p>
            <footer>
              <img src={`/pfps/${quote.handle}.webp`} alt="" width="28" height="28" />
              <span>@{quote.name}</span>
            </footer>
          </blockquote>
        ))}
      </section>

      <section class="notes" aria-labelledby="notes-title">
        <div class="notes-inner">
          <p class="eyebrow">Field notes · thoughts from the build</p>
          <h2 id="notes-title">A little food for thought.</h2>
          <p class="lede">Things we’re learning about building a workspace that is good at the work.</p>
          <div class="note-grid">
            <a class="note" href="/articles/what-is-a-harness">
              <small>01 · Engineering · 4 min read</small>
              <h3>What is a harness?</h3>
              <span>Read the note ↗</span>
            </a>
            <a class="note" href="/articles/code-plus-work">
              <small>02 · Building with agents · 3 min read</small>
              <h3>Code + Work are now one workspace</h3>
              <span>Read the note ↗</span>
            </a>
            <a class="note" href="/articles/agent-autonomy">
              <small>03 · Perspectives · 5 min read</small>
              <h3>How much autonomy should an agent have?</h3>
              <span>Read the note ↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="hero hero-closer" aria-labelledby="hero-title">
        <div class="hero-copy">
          <a class="announcement" href="#playground">
            <b>NEW</b>
            Hand a thread from one agent to another
          </a>
          <h2 id="hero-title">Every agent.<br /><em>One workspace.</em></h2>
          <p class="hero-lede">
            Claude, Codex, Cursor and the rest — on the subscriptions you already
            pay for. One place that keeps the thread, the files, and the plan when
            you switch between them.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary btn-lg" href="#playground">See the handoff</a>
            <a class="btn btn-secondary btn-lg" href="/download">Download for macOS</a>
          </div>
          <div class="hero-proof">
            <div><b>15</b><span>Agents supported</span></div>
            <div><b>1</b><span>Shared thread</span></div>
            <div><b>0</b><span>Tokens resold</span></div>
          </div>
        </div>

        <div class="agent-cluster" aria-hidden="true">
          <div class="stage-3d" id="hero-stage"></div>
          <span class="orbit orbit-a"></span>
          <span class="orbit orbit-b"></span>
          <article class="agent-card is-lime" style="--i: 0">
            <span class="mark" style="--mark:url(/brand/marks/codex.svg)"></span>
            <div class="agent-name">Codex</div>
            <div class="agent-state">Ready to build</div>
            <footer>Modesto / Agent 01</footer>
          </article>
          <article class="agent-card is-glass" style="--i: 1">
            <span class="mark" style="--mark:url(/brand/marks/claude.svg)"></span>
            <div class="agent-name">Claude</div>
            <div class="agent-state">Ready to think</div>
            <footer>Modesto / Agent 02</footer>
          </article>
          <article class="agent-card is-paper" style="--i: 2">
            <span class="mark" style="--mark:url(/brand/marks/cursor.svg)"></span>
            <div class="agent-name">Cursor</div>
            <div class="agent-state">Ready to ship</div>
            <footer>Modesto / Agent 03</footer>
          </article>
        </div>
      </section>

    </main>

    <SiteFooter />

    <ThemeControls pause />

    <script is:inline>
      /*
       * The relay. One brief, three agents, one surviving thread — the thing
       * that actually differentiates Modesto. Every line here is deliberately
       * specific (real file names, real commands, real counts) because the
       * brand voice is "clear, calm, specific"; generic status text like
       * "Processing..." is what made the previous demo feel like a mock.
       */
      const RELAY = [
        {
          agent: "claude",
          name: "Claude",
          role: "Plans the change",
          lines: [
            "read apps/web/src/components/Composer.tsx",
            "found lib/disclosureMotion.ts — reuse, don't rewrite",
            "plan: 3 steps across 2 files",
          ],
          artifact: "plan.md",
          meta: "6 files read · 11s",
          handoff: "Codex picks up <em>plan.md</em> — nothing to re-brief.",
          ms: 2600,
        },
        {
          agent: "codex",
          name: "Codex",
          role: "Writes the code",
          lines: [
            "edit Composer.tsx — arrow + enter navigation",
            "reuse disclosureShellClassName(open)",
            "bun run test — 48 passed",
          ],
          artifact: "composer-nav.diff",
          meta: "+84 −12 · 1m 04s",
          handoff: "Cursor inherits the <em>branch and the diff</em>.",
          ms: 3000,
        },
        {
          agent: "cursor",
          name: "Cursor",
          role: "Ships it",
          lines: [
            "bun fmt · bun lint · bun typecheck — clean",
            "commit to feat/composer-nav",
            "open draft pull request",
          ],
          artifact: "PR #482",
          meta: "draft · ready for review",
          handoff: "The thread stays open — <em>you decide when it merges</em>.",
          ms: 2400,
        },
      ];

      const SAMPLES = {
        sdk: {
          md: `<span class="c"># composer.md</span>
<span class="k">agent:</span> claude
<span class="k">cwd:</span> ./apps/web

Ask Claude to read the composer and add keyboard navigation.
Keep the existing motion. Open a PR when it is good.`,
          ts: `<span class="k">const</span> thread = <span class="k">await</span> <span class="n">modesto</span>.open({
  agent: <span class="s">"claude"</span>,
  cwd: <span class="s">"./apps/web"</span>,
});

<span class="k">await</span> thread.send(<span class="s">"Add keyboard nav to the composer."</span>);
<span class="k">await</span> thread.openPullRequest();`,
        },
        context: {
          md: `<span class="c"># memory.md</span>
Prefer the existing disclosure motion.
Do not invent a second animation system.
Always open a draft PR, never push to main.`,
          ts: `<span class="k">await</span> thread.remember({
  motion: <span class="s">"disclosureMotion.ts"</span>,
  git: <span class="s">"draft PRs only"</span>,
});`,
        },
        git: {
          md: `<span class="c"># pull-request.md</span>
<span class="k">title:</span> Add keyboard navigation to the composer
<span class="k">branch:</span> feat/composer-nav → main
<span class="k">files:</span> Composer.tsx, disclosureMotion.ts`,
          ts: `<span class="k">await</span> thread.commit(<span class="s">"Add composer keyboard nav"</span>);
<span class="k">await</span> thread.openPullRequest({ draft: <span class="k">true</span> });`,
        },
      };

      const FILES = {
        brief: {
          name: "brief.md",
          status: "brief.md saved",
          body: `# A clearer weekly update

## The outcome
Write a useful product brief.

## Read first
- composer.tsx
- disclosureMotion.ts

## Save the result
/workspace/weekly-brief.md

Keep it short. Link the sources.`,
        },
        thread: {
          name: "thread.json",
          status: "thread.json saved",
          body: `{
  "agent": "claude",
  "status": "idle",
  "cwd": "./apps/web",
  "turns": 4
}`,
        },
        diff: {
          name: "composer.tsx",
          status: "composer.tsx staged",
          body: `export function Composer() {
  useHotkeys("mod+k", openCommandMenu);
  return <PromptSurface />;
}`,
        },
        pr: {
          name: "pull-request.md",
          status: "pull-request.md drafted",
          body: `# Add keyboard navigation to the composer

Draft PR from feat/composer-nav.

- Reuses disclosureMotion
- Adds command menu focus
- Leaves main untouched`,
        },
      };

      const JOURNEY = [
        {
          inTitle: "brief.md",
          inText: "What should we change in the composer this week?",
          inFoot: "One clear outcome →",
          outTitle: "composer-nav.tsx",
          outText: "01 The current path\n02 The change\n03 The PR",
          outFoot: "✓ Saved to your workspace",
          chip: "Write ✓",
          text: "Start with an outcome, not a script. Give your agent the brief and the boundaries; it can work out the next useful step.",
          meta: "Input / brief.md",
        },
        {
          inTitle: "composer.tsx",
          inText: "Read the file. Follow its conventions.",
          inFoot: "Source in scope →",
          outTitle: "diff.patch",
          outText: "01 Keyboard path\n02 Focus states\n03 Tests",
          outFoot: "✓ Change is reviewable",
          chip: "Edit ✓",
          text: "Connect the work to the files that matter. The agent should move through the repo with the same taste you would.",
          meta: "Work / composer.tsx",
        },
        {
          inTitle: "diff.patch",
          inText: "The change is ready. Open the PR.",
          inFoot: "One button →",
          outTitle: "pull-request.md",
          outText: "01 Title\n02 Body\n03 Reviewers",
          outFoot: "✓ Draft PR on GitHub",
          chip: "Ship ✓",
          text: "Keep the result. A paused run can continue with its files, decisions, and next step intact.",
          meta: "Result / pull-request.md",
        },
      ];

      let lang = "md";
      let panel = "sdk";

      const nav = document.getElementById("nav");
      const editorCode = document.getElementById("editor-code");
      const editorTitle = document.getElementById("editor-title");
      const editorFoot = document.getElementById("editor-foot");
      const fileContent = document.getElementById("file-content");
      const fileStatus = document.getElementById("file-status");

      const lanesEl = document.getElementById("relay-lanes");
      const elapsedEl = document.getElementById("relay-elapsed");
      const replayBtn = document.getElementById("relay-replay");

      /*
       * Every scheduled step is tagged with the run number it belongs to, so a
       * replay mid-flight cannot have stale timers from the previous run write
       * into the DOM behind it.
       */
      let relayTimers = [];
      let relayRun = 0;

      function relayReduced() {
        return (
          document.documentElement.dataset.reduced === "true" ||
          window.matchMedia("(prefers-reduced-motion: reduce)").matches
        );
      }

      function relayAt(ms, run, fn) {
        relayTimers.push(
          window.setTimeout(() => {
            if (run === relayRun) fn();
          }, ms),
        );
      }

      function mountRelay() {
        if (!lanesEl) return;
        lanesEl.innerHTML = RELAY.map(
          (stage, index) => `
            <li class="lane" data-state="queued" data-index="${index}">
              <span class="lane-dot"><span class="mark" style="--mark:url(/brand/marks/${stage.agent}.svg)"></span></span>
              <div>
                <div class="lane-head">
                  <span class="lane-name">${stage.name}</span>
                  <span class="lane-role">${stage.role}</span>
                  <span class="lane-status">Queued</span>
                </div>
                <div class="lane-log"><div class="lane-log-inner"><ul>
                  ${stage.lines.map((line) => `<li>${line}</li>`).join("")}
                </ul></div></div>
                <div class="lane-artifact"><b>${stage.artifact}</b><span>${stage.meta}</span></div>
                <p class="lane-handoff">${stage.handoff}</p>
              </div>
            </li>`,
        ).join("");
      }

      function relayLane(index) {
        return lanesEl?.querySelector(`.lane[data-index="${index}"]`);
      }

      function relaySet(index, state, status) {
        const lane = relayLane(index);
        if (!lane) return;
        lane.dataset.state = state;
        const statusEl = lane.querySelector(".lane-status");
        if (statusEl) statusEl.textContent = status;
      }

      function relayReset() {
        relayTimers.forEach(window.clearTimeout);
        relayTimers = [];
        relayRun += 1;
        lanesEl?.style.setProperty("--progress", "0");
        RELAY.forEach((_, index) => {
          relaySet(index, "queued", "Queued");
          relayLane(index)
            ?.querySelectorAll(".lane-log li")
            .forEach((line) => line.classList.remove("is-in"));
        });
        if (elapsedEl) elapsedEl.textContent = "READY";
      }

      /* Reduced motion still gets the whole story — just without the timing. */
      function relaySettle() {
        relayReset();
        lanesEl?.style.setProperty("--progress", "1");
        RELAY.forEach((_, index) => {
          relaySet(index, "done", "Done");
          relayLane(index)
            ?.querySelectorAll(".lane-log li")
            .forEach((line) => line.classList.add("is-in"));
        });
        if (elapsedEl) elapsedEl.textContent = "DONE · DRAFT PR #482";
      }

      function relayPlay() {
        if (relayReduced()) {
          relaySettle();
          return;
        }
        relayReset();
        const run = relayRun;
        let at = 320;

        RELAY.forEach((stage, index) => {
          const lane = relayLane(index);
          if (!lane) return;
          const lines = lane.querySelectorAll(".lane-log li");
          const beat = Math.max(340, Math.floor(stage.ms / (lines.length + 1)));

          relayAt(at, run, () => {
            relaySet(index, "working", "Working");
            lanesEl?.style.setProperty("--progress", String((index + 0.4) / RELAY.length));
            if (elapsedEl) elapsedEl.textContent = `${stage.name.toUpperCase()} · WORKING`;
          });
          lines.forEach((line, k) =>
            relayAt(at + beat * (k + 1), run, () => line.classList.add("is-in")),
          );

          at += stage.ms;
          relayAt(at, run, () => {
            relaySet(index, "done", "Done");
            lanesEl?.style.setProperty("--progress", String((index + 1) / RELAY.length));
          });
          at += 720;
        });

        relayAt(at, run, () => {
          if (elapsedEl) elapsedEl.textContent = "DONE · DRAFT PR #482";
        });
      }

      replayBtn?.addEventListener("click", relayPlay);

      /* Autoplay once, when the relay is actually on screen. */
      if (lanesEl) {
        const relayObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              relayObserver.disconnect();
              relayPlay();
            });
          },
          { threshold: 0.25 },
        );
        relayObserver.observe(lanesEl);
      }

      function renderEditor() {
        const sample = SAMPLES[panel][lang];
        if (editorCode) editorCode.innerHTML = sample;
        if (editorTitle) editorTitle.textContent = lang === "md" ? "composer.md" : "agent.ts";
        if (editorFoot) {
          editorFoot.textContent =
            panel === "git"
              ? "Example git · One button to a PR"
              : panel === "context"
                ? "Example memory · Carry the brief forward"
                : "Example composer · Bring your own model";
        }
      }

      document.querySelectorAll(".product-tab[data-panel]").forEach((tab) => {
        tab.addEventListener("click", () => {
          panel = tab.getAttribute("data-panel") ?? "sdk";
          document.querySelectorAll(".product-tab[data-panel]").forEach((item) => {
            item.setAttribute("aria-selected", String(item === tab));
          });
          renderEditor();
        });
      });

      document.querySelectorAll(".lang-tab").forEach((tab) => {
        tab.addEventListener("click", () => {
          lang = tab.getAttribute("data-lang") ?? "md";
          document.querySelectorAll(".lang-tab").forEach((item) => {
            item.setAttribute("aria-selected", String(item === tab));
          });
          renderEditor();
        });
      });

      document.getElementById("copy-code")?.addEventListener("click", async () => {
        const text = editorCode?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(text);
          const button = document.getElementById("copy-code");
          if (button) button.textContent = "Copied";
          window.setTimeout(() => {
            if (button) button.textContent = "Copy";
          }, 1200);
        } catch {
          /* ignore */
        }
      });

      document.querySelectorAll(".journey-tab").forEach((tab) => {
        tab.addEventListener("click", () => {
          const step = Number(tab.getAttribute("data-step") ?? "0");
          const data = JOURNEY[step];
          document.querySelectorAll(".journey-tab").forEach((item) => {
            item.setAttribute("aria-selected", String(item === tab));
          });
          const set = (id, value) => {
            const el = document.getElementById(id);
            if (el) el.textContent = value;
          };
          set("board-in-title", data.inTitle);
          set("board-in", data.inText);
          set("board-in-foot", data.inFoot);
          set("board-out-title", data.outTitle);
          set("board-out", data.outText);
          set("board-out-foot", data.outFoot);
          set("board-mid-chip", data.chip);
          set("journey-text", data.text);
          set("journey-meta", data.meta);
        });
      });

      document.querySelectorAll(".workspace-file").forEach((button) => {
        button.addEventListener("click", () => {
          const key = button.getAttribute("data-file") ?? "brief";
          const file = FILES[key];
          document.querySelectorAll(".workspace-file").forEach((item) => {
            item.setAttribute("aria-pressed", String(item === button));
          });
          if (fileContent) fileContent.textContent = file.body;
          if (fileStatus) fileStatus.textContent = file.status;
        });
      });

      document.querySelectorAll(".control .product-tab").forEach((tab) => {
        tab.addEventListener("click", () => {
          document.querySelectorAll(".control .product-tab").forEach((item) => {
            item.setAttribute("aria-selected", String(item === tab));
          });
        });
      });

      const approve = document.getElementById("approve");
      approve?.addEventListener("click", () => {
        approve.classList.add("is-done");
        approve.textContent = "Publish approved";
      });

      window.addEventListener(
        "scroll",
        () => {
          if (!nav) return;
          nav.classList.toggle("is-scrolled", window.scrollY > 8);
        },
        { passive: true },
      );

      mountRelay();
      renderEditor();
      if (fileContent) fileContent.textContent = FILES.brief.body;
    </script>

    <script type="module" is:inline>
      import { mountAgentCards, mountRings, mountFilmKnot } from "/brand/modesto-3d.js";
      mountAgentCards(document.getElementById("hero-stage")).catch(() => {
        /* CSS cards remain as the fallback. */
      });
      mountFilmKnot(document.getElementById("film-knot-stage"));
      mountRings(document.getElementById("ring-stage")).catch(() => {
        /* The section reads fine without the ring. */
      });
    </script>
  </body>
</html>
