import DocsLayout from "../../layouts/DocsLayout.astro";

const toc = [
  { label: "Code and Work", href: "#code-and-work" },
  { label: "Choosing a workspace", href: "#choosing" },
  { label: "Sessions", href: "#sessions" },
  { label: "Connections", href: "#connections" },
  { label: "Music and canvas", href: "#music" },
