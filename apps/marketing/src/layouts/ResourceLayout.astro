---
import IslandNav from "../components/IslandNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeControls from "../components/ThemeControls.astro";
import "../styles/resources.css";
interface Props { title?: string; description?: string; }
const { title = "Modesto — Every agent. One workspace.", description = "The workspace that keeps your agents, tools, and context together." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10120f" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/announcements/modesto-saas-assets/vendor/manrope.ttf" as="font" type="font/ttf" crossorigin />
    <ThemeBoot />
  </head>
  <body class="resource-site">
    <a class="skip" href="#main-content">Skip to content</a>
    <IslandNav />
    <main class="resource-main" id="main-content"><slot /></main>
    <SiteFooter />
    <ThemeControls />
  </body>
</html>
