---
import Layout from "./ResourceLayout.astro";
import { DOCS_NAV, docsNeighbors } from "../lib/docs";
import { REPO_URL } from "../lib/releases";

interface TocItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  currentPath: string;
  eyebrow?: string;
  toc?: TocItem[];
}

const {
  title,
  description,
  currentPath,
  eyebrow = "Documentation",
  toc = [],
} = Astro.props;

const { previous, next } = docsNeighbors(currentPath);
---

<Layout title={`${title} — Modesto Docs`} description={description}>
  <div class="docs-shell">
    <header class="docs-hero">
      <p class="eyebrow">Modesto / Docs</p>
      <div class="docs-hero-row">
        <div>
          <p class="docs-breadcrumb">
            <a href="/docs">Docs</a>
            <span aria-hidden="true">/</span>
            <span>{eyebrow}</span>
          </p>
          <h1>{title}</h1>
          <p class="docs-lede">{description}</p>
        </div>
        <label class="docs-search">
          <span aria-hidden="true">⌕</span>
          <input
            id="docs-search"
            type="search"
            aria-label="Filter documentation"
            placeholder="Filter docs…"
            autocomplete="off"
          />
          <kbd>⌘K</kbd>
        </label>
      </div>
    </header>

    <div class="docs-layout">
      <aside class="docs-nav" aria-label="Documentation">
        {
          DOCS_NAV.map((group) => (
            <section>
              <h2>{group.label}</h2>
              <nav>
                {group.links.map((link) => (
                  <a
                    href={link.href}
                    class:list={{ active: currentPath === link.href }}
                    aria-current={currentPath === link.href ? "page" : undefined}
                    data-doc-link
                  >
                    {link.label}
                  </a>
                ))}
              </nav>
            </section>
          ))
        }
        <a class="docs-nav-github" href={REPO_URL} target="_blank" rel="noopener noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </aside>

      <article class="docs-article">
        <div class="docs-prose">
          <slot />
        </div>

        <footer class="docs-pager">
          {
            previous ? (
              <a href={previous.href} class="docs-pager-link">
                <span>Previous</span>
                <strong>{previous.label}</strong>
              </a>
            ) : (
              <span></span>
            )
          }
          {
            next ? (
              <a href={next.href} class="docs-pager-link docs-pager-next">
                <span>Next</span>
                <strong>{next.label}</strong>
              </a>
            ) : (
              <span></span>
            )
          }
        </footer>
      </article>

      <aside class="docs-toc" aria-label="On this page">
        <span>On this page</span>
        <nav>
          {toc.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <a class="docs-issue" href={`${REPO_URL}/issues/new`} target="_blank" rel="noopener noreferrer">
          Report an issue <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>
  </div>

  <script>
    const docsSearch = document.getElementById("docs-search");
    const docLinks = Array.from(document.querySelectorAll("[data-doc-link]"));

    if (docsSearch instanceof HTMLInputElement) {
      docsSearch.addEventListener("input", () => {
        const query = docsSearch.value.trim().toLowerCase();
        for (const link of docLinks) {
          const matches = !query || link.textContent?.toLowerCase().includes(query);
          link.toggleAttribute("hidden", !matches);
        }
      });

      window.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          docsSearch.focus();
        }
      });
    }
  </script>
</Layout>

<style>
  .docs-hero {
    padding: 8px 0 36px;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .docs-hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: 32px;
    align-items: end;
    margin-top: 18px;
  }

  .docs-breadcrumb {
    display: flex;
    gap: 8px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .docs-breadcrumb a:hover {
    color: var(--foreground);
  }

  .docs-hero h1 {
    margin: 16px 0 0;
    max-width: 18ch;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .docs-lede {
    max-width: 46ch;
    margin: 18px 0 0;
    color: var(--muted-foreground);
    font-size: 17px;
    line-height: 1.6;
  }

  .docs-search {
    height: 44px;
    padding: 0 14px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    color: var(--muted-foreground);
  }

  .docs-search input {
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--foreground);
    font: 13px var(--font-sans);
  }

  .docs-search kbd {
    padding: 3px 7px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font: 10px var(--font-mono);
  }

  .docs-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 176px;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    padding: 36px 0 96px;
  }

  .docs-nav,
  .docs-toc {
    position: sticky;
    top: 108px;
    max-height: calc(100vh - 128px);
    overflow-y: auto;
    padding-bottom: 24px;
  }

  .docs-nav section + section {
    margin-top: 28px;
  }

  .docs-nav h2,
  .docs-toc > span {
    margin: 0 0 10px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .docs-nav nav,
  .docs-toc nav {
    display: grid;
    gap: 2px;
  }

  .docs-nav a {
    padding: 7px 10px;
    border-radius: 8px;
    color: var(--muted-foreground);
    font-size: 13px;
    line-height: 1.4;
  }

  @media (hover: hover) and (pointer: fine) {
    .docs-nav a:hover {
      background: color-mix(in srgb, var(--accent) 16%, transparent);
      color: var(--foreground);
    }
  }

  .docs-nav a.active {
    background: var(--accent);
    color: #14180f;
  }

  .docs-nav-github {
    display: inline-block;
    margin-top: 28px;
    color: var(--fg-dim);
    font-size: 12px;
  }

  .docs-article {
    min-width: 0;
    padding-top: 8px;
  }

  .docs-prose {
    color: var(--muted-foreground);
    font-size: 16px;
    line-height: 1.72;
  }

  .docs-prose :global(section) {
    padding-top: 56px;
    scroll-margin-top: 120px;
  }

  .docs-prose :global(section:first-child) {
    padding-top: 0;
  }

  .docs-prose :global(section + section) {
    margin-top: 8px;
    border-top: 1px solid var(--border);
  }

  .docs-prose :global(h2) {
    color: var(--foreground);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .docs-prose :global(h3) {
    margin-top: 28px;
    color: var(--foreground);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .docs-prose :global(p) {
    margin-top: 16px;
  }

  .docs-prose :global(.platform-inline),
  .docs-prose :global(.platform-kicker) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--foreground);
    white-space: nowrap;
  }

  .docs-prose :global(.platform-inline) {
    margin: 0 2px;
  }

  .docs-prose :global(ul),
  .docs-prose :global(ol) {
    margin: 18px 0 0;
    padding-left: 1.2rem;
  }

  .docs-prose :global(li + li) {
    margin-top: 8px;
  }

  .docs-prose :global(li::marker) {
    color: var(--accent);
  }

  .docs-prose :global(a) {
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-underline-offset: 3px;
  }

  .docs-prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .docs-prose :global(code) {
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    color: var(--foreground);
    font: 0.84em var(--font-mono);
  }

  .docs-prose :global(.docs-code) {
    margin-top: 22px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: #10120f;
    color: #eceee6;
  }

  .docs-prose :global(.docs-code-head) {
    min-height: 40px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #ffffff18;
    color: #8b9681;
    font: 10px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .docs-prose :global(pre) {
    margin: 0;
    padding: 18px 16px;
    overflow-x: auto;
  }

  .docs-prose :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 13px;
    line-height: 1.7;
  }

  .docs-prose :global(.docs-callout) {
    margin-top: 22px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--card);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .docs-prose :global(.docs-callout strong) {
    display: block;
    color: var(--foreground);
    font-size: 13px;
    font-weight: 600;
  }

  .docs-prose :global(.docs-callout p) {
    margin-top: 6px;
    font-size: 14px;
  }

  .docs-prose :global(.docs-card-grid) {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .docs-prose :global(.docs-card-grid-wide) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .docs-prose :global(.docs-card) {
    min-height: 148px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--card);
  }

  .docs-prose :global(.docs-card:hover) {
    border-color: var(--border-strong);
  }

  .docs-prose :global(.docs-card span) {
    color: var(--fg-dim);
    font: 10px var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .docs-prose :global(.docs-card > img) {
    width: 28px;
    height: 28px;
    object-fit: contain;
    filter: grayscale(1) contrast(1.2);
  }

  :global([data-theme="dark"]) .docs-prose :global(.docs-card > img) {
    filter: grayscale(1) invert(1);
  }

  .docs-prose :global(.docs-card h3) {
    margin-top: 14px;
  }

  .docs-prose :global(.docs-card p) {
    margin-top: 8px;
    font-size: 13px;
  }

  .docs-prose :global(.docs-card a) {
    display: inline-block;
    margin-top: 16px;
    font-size: 12px;
  }

  .docs-prose :global(.docs-table) {
    margin-top: 22px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--card);
  }

  .docs-prose :global(.docs-table > div) {
    padding: 14px 16px;
    display: grid;
    grid-template-columns: minmax(140px, 0.75fr) minmax(0, 1.4fr);
    gap: 20px;
    border-bottom: 1px solid var(--border);
  }

  .docs-prose :global(.docs-table > div:last-child) {
    border-bottom: 0;
  }

  .docs-prose :global(.docs-table strong) {
    color: var(--foreground);
    font-weight: 600;
  }

  .docs-prose :global(.docs-steps) {
    margin-top: 22px;
    counter-reset: docs-step;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--card);
  }

  .docs-prose :global(.docs-steps > article) {
    padding: 18px 16px;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
    border-bottom: 1px solid var(--border);
    counter-increment: docs-step;
  }

  .docs-prose :global(.docs-steps > article:last-child) {
    border-bottom: 0;
  }

  .docs-prose :global(.docs-steps > article::before) {
    color: var(--accent-ink);
    font: 10px var(--font-mono);
    content: "0" counter(docs-step);
  }

  .docs-prose :global(.docs-steps h3) {
    margin-top: 0;
  }

  .docs-prose :global(.docs-steps p) {
    margin-top: 6px;
    font-size: 14px;
  }

  .docs-prose :global(.docs-integration) {
    margin-top: 22px;
    padding: 18px;
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 14px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--card);
  }

  .docs-prose :global(.docs-integration img) {
    width: 32px;
    height: 32px;
    object-fit: contain;
    filter: grayscale(1);
  }

  :global([data-theme="dark"]) .docs-prose :global(.docs-integration img) {
    filter: grayscale(1) invert(1);
  }

  :global([data-theme="dark"]) .docs-prose :global(.docs-integration img[src$=".png"]) {
    filter: grayscale(1);
  }

  .docs-prose :global(.docs-integration h3) {
    margin-top: 0;
  }

  .docs-prose :global(.docs-integration p) {
    margin-top: 4px;
    font-size: 14px;
  }

  .docs-pager {
    margin-top: 64px;
    padding-top: 22px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    border-top: 1px solid var(--border);
  }

  .docs-pager-link {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--card);
    text-decoration: none !important;
  }

  .docs-pager-link span {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .docs-pager-link strong {
    color: var(--foreground);
    font-size: 16px;
    font-weight: 500;
  }

  .docs-pager-next {
    text-align: right;
    justify-self: end;
    width: 100%;
  }

  .docs-toc nav a {
    padding: 5px 0 5px 12px;
    border-left: 1px solid var(--border);
    color: var(--fg-dim);
    font-size: 12px;
    line-height: 1.4;
  }

  .docs-toc nav a:hover {
    border-left-color: var(--accent);
    color: var(--foreground);
  }

  .docs-issue {
    display: inline-block;
    margin-top: 24px;
    color: var(--fg-dim);
    font-size: 12px;
  }

  @media (max-width: 1080px) {
    .docs-layout {
      grid-template-columns: 190px minmax(0, 1fr);
    }

    .docs-toc {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .docs-hero-row,
    .docs-layout,
    .docs-pager {
      grid-template-columns: 1fr;
    }

    .docs-search {
      width: 100%;
    }

    .docs-nav {
      position: static;
      max-height: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .docs-nav section + section {
      margin-top: 0;
    }

    .docs-nav-github {
      grid-column: 1 / -1;
    }

    .docs-pager-next {
      text-align: left;
    }
  }
</style>
